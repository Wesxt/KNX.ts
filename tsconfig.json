{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022"
    ],
    "declaration": true,
    "incremental": true,
    "isolatedModules": true,
    "types": [
      "node",
      "jest"
    ],
    "noEmit": true,
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "manual-tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}