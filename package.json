{
  "name": "knx.ts",
  "version": "1.1.1",
  "description": "A high-performance KNXnet/IP server and client library in TypeScrip, focused on ETS stability, with gateways to MQTT and Modbus.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wesxt/KNX.ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "tsc && node dist/index.js",
    "watch": "tsc -w",
    "test": "jest",
    "manualTest:router": "tsx manual-tests/router.ts",
    "manualTest:tunneling": "tsx manual-tests/tunneling_manual.ts",
    "manualTest:routing": "tsx manual-tests/routing_manual.ts",
    "manualTest:usb": "tsx manual-tests/test_usb_manual.ts",
    "manualTest:routingUsb": "tsx manual-tests/usb_routing_manual.ts",
    "manualTest:tpuart": "tsx manual-tests/tpuart_manual.ts",
    "pack:test": "npm pack",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "contributors": [
    {
      "name": "Arnold Steven Beleño Zuletta",
      "email": "lordwesxt@gmail.com"
    }
  ],
  "keywords": [
    "knx",
    "knxnetip",
    "tunnelling",
    "routing",
    "automation",
    "smarthome",
    "typescript"
  ],
  "author": "Arnold Steven Beleño Zuletta (Wesxt)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/node-hid": "^3.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "dependencies": {
    "node-hid": "^3.3.0",
    "serialport": "^13.0.0"
  }
}
