{
  "name": "knx.ts",
  "version": "2.4.1",
  "description": "A high-performance KNXnet/IP server and client library in TypeScript, focused on ETS stability.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wesxt/KNX.ts.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "readme-es.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "tsc -p tsconfig.build.json && node dist/index.js",
    "watch": "tsc -p tsconfig.build.json -w",
    "test": "jest",
    "test:stability": "tsx test/stability/tunneling_stability.ts",
    "test:server-stability": "tsx test/stability/server_tunneling_stability.ts",
    "manualTest:router": "tsx manual-tests/router.ts",
    "manualTest:tunneling": "tsx manual-tests/tunneling_manual.ts",
    "manualTest:management": "tsx manual-tests/management_tunnel_manual.ts",
    "manualTest:program": "tsx manual-tests/program_device_manual.ts",
    "manualTest:secureTcp": "tsx manual-tests/secure_tunnel_tcp_manual.ts",
    "manualTest:dataSecure": "tsx manual-tests/data_secure_manual.ts",
    "manualTest:routing": "tsx manual-tests/routing_manual.ts",
    "manualTest:usb": "tsx manual-tests/test_usb_manual.ts",
    "manualTest:routingUsb": "tsx manual-tests/usb_routing_manual.ts",
    "manualTest:tpuart": "tsx manual-tests/tpuart_manual.ts",
    "api:demo": "tsx api-server/server.ts",
    "pack:test": "npm pack",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "contributors": [
    {
      "name": "Arnold Steven Beleño Zuletta",
      "email": "lordwesxt@gmail.com"
    }
  ],
  "keywords": [
    "knx",
    "knxnetip",
    "tunnelling",
    "routing",
    "automation",
    "smarthome",
    "typescript"
  ],
  "author": "Arnold Steven Beleño Zuletta (Wesxt)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "node-hid": "^3.4.0",
    "serialport": "^13.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.28.2": true,
    "node-hid@3.4.0": true
  }
}
